PORT=4000
FRONTEND_URL=http://localhost:3000

# Supabase Postgres — from Dashboard → Connect
# Session pooler (port 5432) for Prisma migrations + local backend
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public

# Same as DATABASE_URL for local/dev, or use Direct connection (db.[PROJECT-REF].supabase.co:5432)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public

# Supabase Auth — from Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Auth emails (confirm / reset) are sent via Supabase custom SMTP → Resend
# Configure in Dashboard → Authentication → Emails → SMTP Settings
# Host: smtp.resend.com | Port: 465 | User: resend | Pass: <Resend API key>
